-- DCS Music Player v0.5.0
-- Dark compact layout: title/time in window header, controls + playlist, slider.

local function button(x, y, w, h, text, tooltip, enabled)
    return {
        ["params"] = {
            ["bounds"] = { ["h"] = h, ["w"] = w, ["x"] = x, ["y"] = y },
            ["enabled"] = enabled ~= false,
            ["tabOrder"] = 0,
            ["text"] = text,
            ["tooltip"] = tooltip or "",
            ["visible"] = true,
            ["zindex"] = 1
        },
        ["skin"] = { ["params"] = { ["name"] = "buttonSkinAwacs" } },
        ["type"] = "Button"
    }
end

